# ── App ──
NODE_ENV=development
PORT=3333
CORS_ORIGIN=http://localhost:3000

# ── Database ──
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=urbannest

# ── JWT ──
JWT_SECRET=change-me-min-16-chars-local-dev
JWT_EXPIRES_IN=7d

# ── Redis (optional — in-memory fallback used when unset) ──
# REDIS_URL=redis://localhost:6379

# ── AI Providers (set at least one) ──
AGENT_PROVIDER=openai
OPENAI_API_KEY=
# AGENT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
AGENT_MODEL=gpt-4o
AGENT_ANTHROPIC_MODEL=claude-sonnet-4-20250514
AGENT_MAX_STEPS=10
AGENT_QUEUE_ENABLED=false
AGENT_PLAN_FIRST=false

# ── SMS (stub logs OTP to console in dev) ──
SMS_PROVIDER=stub

# ── Storage (optional — upload disabled when unset) ──
# AWS_REGION=ap-south-1
# S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Mapbox (optional — geocoding disabled when unset) ──
# MAPBOX_ACCESS_TOKEN=

# ── Admin phones (comma-separated) ──
ADMIN_PHONES=
BROKER_PHONES=

# ── Rate limiting ──
THROTTLE_TTL=60
THROTTLE_LIMIT=100
AGENT_RATE_LIMIT_PER_MIN=10

# ── Timeouts ──
REQUEST_TIMEOUT_MS=30000
AREA_ASSESSMENT_TTL_DAYS=30
