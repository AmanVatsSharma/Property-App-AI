# ── App ──────────────────────────────────────────
NODE_ENV=development
PORT=3333

# ── Database ─────────────────────────────────────
# Local dev: Podman Postgres on 5433 (password auth). Host :5432 often uses ident for TCP — Node cannot use DB_USER/DB_PASSWORD until pg_hba uses scram.
#   podman run -d --name property-app-postgres -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=property_app -p 5433:5432 --restart unless-stopped docker.io/library/postgres:16-alpine
# docker compose postgres uses host port 5432 — set DB_PORT=5432 when using that stack only.
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=property_app
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000

# ── Auth ─────────────────────────────────────────
JWT_SECRET=changeme-min-16-chars-required
JWT_EXPIRES_IN=7d
# Comma-separated phone numbers auto-upgraded to admin/broker on first login
ADMIN_PHONES=9999999999
BROKER_PHONES=

# ── CORS ─────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
# Production: CORS_ORIGIN=https://yourdomain.com (no wildcard allowed)

# ── Redis (optional — enables queue + realtime) ──
REDIS_URL=redis://localhost:6379

# ── AI Agent ─────────────────────────────────────
AGENT_PROVIDER=openai          # openai | anthropic
OPENAI_API_KEY=
AGENT_MODEL=gpt-4o
ANTHROPIC_API_KEY=
AGENT_ANTHROPIC_MODEL=claude-sonnet-4-20250514
AGENT_MAX_STEPS=10
AGENT_QUEUE_ENABLED=false
AGENT_RATE_LIMIT_PER_MIN=10
AGENT_THINKING_BUDGET_TOKENS=
AGENT_PLAN_FIRST=false

# ── SMS / OTP ────────────────────────────────────
SMS_PROVIDER=stub              # stub | twilio | msg91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MSG91_AUTH_KEY=
MSG91_SENDER=SMSIND

# ── Storage (S3) ─────────────────────────────────
AWS_REGION=ap-south-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ── Geocoding / Maps ─────────────────────────────
MAPBOX_ACCESS_TOKEN=

# ── Rate Limiting ────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100
REQUEST_TIMEOUT_MS=30000

# ── Logging ──────────────────────────────────────
LOG_LEVEL=debug

# ── Area Assessment ──────────────────────────────
AREA_ASSESSMENT_TTL_DAYS=30
AREA_PROVIDER=none             # none | mapbox

# ── Site URL (used by web) ───────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── SMTP / Email ─────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=UrbanNest.ai <noreply@urbannest.ai>
