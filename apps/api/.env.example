# ── App ──────────────────────────────────────────
NODE_ENV=development
PORT=3333

# ── Database ─────────────────────────────────────
# DB_TYPE=sqlite   → zero-config file-based DB for local dev (default). No Postgres required.
#                    Creates dev.sqlite in repo root automatically on first start.
# DB_TYPE=postgres → PostgreSQL for production (or local dev if you prefer).
#
# To use SQLite (recommended for local dev):
DB_TYPE=sqlite
DB_PATH=./dev.sqlite

# To use PostgreSQL instead (start Postgres first):
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5433          # Podman one-liner maps container :5432 → host :5433
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=property_app
# DB_POOL_MAX=20
# DB_POOL_IDLE_TIMEOUT_MS=30000
#
# Podman one-liner for local Postgres:
#   podman run -d --name property-app-postgres \
#     -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=property_app \
#     -p 5433:5432 --restart unless-stopped \
#     docker.io/library/postgres:16-alpine

# ── Auth ─────────────────────────────────────────
JWT_SECRET=changeme-min-16-chars-required
JWT_EXPIRES_IN=7d
# Comma-separated phone numbers auto-upgraded to admin/broker on first login
ADMIN_PHONES=9999999999
BROKER_PHONES=

# ── CORS ─────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
# Production: CORS_ORIGIN=https://yourdomain.com (no wildcard allowed)

# ── Redis (optional — enables queue + realtime) ──
REDIS_URL=redis://localhost:6379

# ── AI Agent ─────────────────────────────────────
AGENT_PROVIDER=google          # openai | anthropic | google
GOOGLE_API_KEY=
AGENT_GOOGLE_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
AGENT_MODEL=gpt-4o
ANTHROPIC_API_KEY=
AGENT_ANTHROPIC_MODEL=claude-sonnet-4-20250514
AGENT_MAX_STEPS=10
AGENT_QUEUE_ENABLED=false
AGENT_RATE_LIMIT_PER_MIN=10
AGENT_THINKING_BUDGET_TOKENS=
AGENT_PLAN_FIRST=false

# ── SMS / OTP ────────────────────────────────────
SMS_PROVIDER=stub              # stub | twilio | msg91 | zavu
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# MSG91: API Auth Key from control.msg91.com (API section). Not the OTP Login Widget client token.
MSG91_AUTH_KEY=
MSG91_SENDER=SMSIND
# REST OTP (POST /auth/otp/*): Control API v5 — GraphQL uses legacy sendotp.php instead; see auth MODULE_DOC.md
# MSG91_TEMPLATE_ID = dashboard template id with ##OTP##
MSG91_TEMPLATE_ID=
# MSG91_OTP_BASE_URL=https://control.msg91.com/api/v5
# MSG91_OTP_HTTP_TIMEOUT_MS=15000
# MSG91_OTP_HTTP_RETRIES=2
REST_OTP_MSG91_ENABLED=true
# OTP_BCRYPT_ROUNDS=10
# OTP_REST_TTL_SEC=300
# OTP_REST_SEND_RATE_LIMIT=5
# OTP_REST_SEND_RATE_WINDOW_SEC=600
# OTP_REST_MAX_VERIFY_ATTEMPTS=3
# OTP_REST_RESEND_COOLDOWN_SEC=60
# Zavu (https://zavu.dev) — use SMS_PROVIDER=zavu and set API key (zv_live_* / zv_test_*)
ZAVUDEV_API_KEY=
# Optional Zavu sender profile ID (Zavu-Sender header)
ZAVUDEV_SENDER=

# ── WhatsApp Business API (OTP via Meta) ─────────
# Get credentials from: https://business.facebook.com → WhatsApp → Settings → API
# Template must be pre-approved in Meta Business Console with {{1}} parameter for OTP
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=   # Phone number ID from WhatsApp API setup
WHATSAPP_WABA_ID=           # WhatsApp Business Account ID
WHATSAPP_TEMPLATE_NAME=otp_verification  # Pre-approved template name
WHATSAPP_LANGUAGE_CODE=en   # Template language code (en, hi, etc.)

# ── WhatsApp QR OTP (WhatsApp Web scan — no Meta Business API needed) ───────
# Enable WhatsApp QR-based login. User scans a QR with their phone to link the session,
# then receives the OTP as a WhatsApp message in that same chat.
WHATSAPP_QR_ENABLED=false
# Your WhatsApp number (with country code, no + prefix) used as the linked device identity.
# WhatsApp_QR_OWN_NUMBER=91XXXXXXXXXX

# ── Storage (S3) ─────────────────────────────────
AWS_REGION=ap-south-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ── Geocoding / Maps ─────────────────────────────
MAPBOX_ACCESS_TOKEN=

# ── Rate Limiting ────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100
REQUEST_TIMEOUT_MS=30000

# ── Logging ──────────────────────────────────────
LOG_LEVEL=debug

# ── Area Assessment ──────────────────────────────
AREA_ASSESSMENT_TTL_DAYS=30
AREA_PROVIDER=none             # none | mapbox

# ── Site URL (used by web) ───────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── SMTP / Email ─────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=UrbanNest.ai <noreply@urbannest.ai>
