{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "targets": {
    "compile": {
      "executor": "@nx/js:swc",
      "outputs": ["{workspaceRoot}/dist/apps/api"],
      "options": {
        "main": "apps/api/src/main.ts",
        "outputPath": "dist/apps/api",
        "tsConfig": "apps/api/tsconfig.app.json",
        "swcrc": "apps/api/.swcrc",
        "skipTypeCheck": true,
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/api/src/assets",
            "output": "assets"
          }
        ],
        "watch": false
      },
      "configurations": {
        "development": {
          "watch": true
        }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "NODE_OPTIONS='--max-old-space-size=8192' webpack-cli build",
        "args": ["--node-env=production"],
        "cwd": "apps/api"
      },
      "configurations": {
        "development": {
          "args": ["--node-env=development"]
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/api/package.json",
        "{workspaceRoot}/dist/apps/api/package-lock.json"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/api/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "api:compile:development",
        "runBuildTargetDependencies": false,
        "watch": true
      },
      "configurations": {
        "development": {
          "buildTarget": "api:compile:development"
        },
        "production": {
          "buildTarget": "api:build:production"
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx jest --config jest.config.js --passWithNoTests",
        "cwd": "apps/api"
      },
      "outputs": ["{workspaceRoot}/coverage/apps/api"]
    },
    "migration:run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r @swc-node/register src/database/run-migrations.ts",
        "cwd": "apps/api"
      }
    }
  },
  "tags": []
}
