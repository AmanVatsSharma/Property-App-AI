# Property-App-AI Web (Next.js) — example env. Copy to .env.local in this directory.
# NEXT_PUBLIC_* are exposed to the browser; never put secrets here.
# See docs/DEPLOYMENT.md § Web.

# Required: at least one so search and property detail use the real API (no mock).
NEXT_PUBLIC_GRAPHQL_HTTP=http://localhost:3333/graphql
# Or set API base URL; GraphQL is derived as ${NEXT_PUBLIC_API_URL}/graphql
# NEXT_PUBLIC_API_URL=http://localhost:3333

# Optional: app-download links (footer / mobile prompt). Omit or leave empty to hide or use placeholders.
# NEXT_PUBLIC_APP_STORE_URL=
# NEXT_PUBLIC_PLAY_STORE_URL=
