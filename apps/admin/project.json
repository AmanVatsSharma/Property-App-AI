{
  "name": "admin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "dev": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/admin",
        "command": "next dev --port 3001"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/admin",
        "command": "next build"
      }
    },
    "start": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/admin",
        "command": "next start --port 3001"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/admin",
        "command": "eslint"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/admin",
        "command": "vitest run"
      }
    }
  }
}
