# Property-App-AI Admin (Next.js) — example env. Copy to .env.local in this directory.
# NEXT_PUBLIC_* are exposed to the browser; never put secrets here.
NEXT_PUBLIC_GRAPHQL_HTTP=http://localhost:3333/graphql
# Or set API base URL; GraphQL is derived as ${NEXT_PUBLIC_API_URL}/graphql
# NEXT_PUBLIC_API_URL=http://localhost:3333
